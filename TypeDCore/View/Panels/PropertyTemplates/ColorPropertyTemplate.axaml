<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DataTemplate x:Key="ColorPropertyTemplate">
        <ColorPicker Color="{Binding AvaloniaColor, Mode=TwoWay}"
                        IsAlphaEnabled="True"
                        IsEnabled="{Binding !ReadOnly}"
                        Classes="PropertyInput"
                        HorizontalAlignment="Left">
            <ColorPicker.KeyBindings>
                <KeyBinding Gesture="Ctrl+C" Command="{Binding CopyCommand}"/>
                <KeyBinding Gesture="Ctrl+V" Command="{Binding PasteCommand}"/>
            </ColorPicker.KeyBindings>
            <ColorPicker.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Copy color" InputGesture="Ctrl+C" Command="{Binding CopyCommand}"/>
                    <MenuItem Header="Paste color" InputGesture="Ctrl+V" Command="{Binding PasteCommand}"/>
                </ContextMenu>
            </ColorPicker.ContextMenu>
        </ColorPicker>
    </DataTemplate>
</ResourceDictionary>
