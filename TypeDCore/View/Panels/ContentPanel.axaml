<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:TypeDCore.ViewModel.Panels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:local="clr-namespace:TypeDCore.View.Panels"
             x:Class="TypeDCore.ContentPanel"
             x:DataType="vm:ContentPanelViewModel">
    <Grid RowDefinitions="Auto, *" Margin="8">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox Width="300" Watermark="Search..." Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Content="Clear" Command="{Binding ClearSearchCommand}"/>
        </StackPanel>

        <ListBox Grid.Row="1" x:Name="ContentList" Margin="0,8,0,0" Background="Transparent"
                 ItemsSource="{Binding FilteredItems}"
                 SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                 GotFocus="ContentList_GotFocus"
                 KeyDown="ContentList_KeyDown"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ContextMenu>
                <ContextMenu Opening="ContextMenu_Opening">
                    <MenuItem Header="Rename" InputGesture="F2" Click="Rename_Click"/>
                    <MenuItem Header="Show in Explorer" Click="ShowInExplorer_Click"/>
                    <MenuItem Header="Delete" InputGesture="Delete" Click="Delete_Click"/>
                </ContextMenu>
            </ListBox.ContextMenu>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="160" Margin="4" Background="Transparent">
                        <Border Height="110" BorderBrush="#FFCCCCCC" BorderThickness="1" CornerRadius="4">
                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="4">
                                <ToolTip.Tip>
                                    <Border Background="White" Padding="4" BorderBrush="#FFCCCCCC" BorderThickness="1">
                                        <ScrollViewer MaxWidth="800" MaxHeight="600" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                            <Image Source="{Binding Thumbnail}" Stretch="None" />
                                        </ScrollViewer>
                                    </Border>
                                </ToolTip.Tip>
                            </Image>
                        </Border>
                        <TextBlock Text="{Binding Title}" IsVisible="{Binding !IsEditing}" Margin="2,4,2,0"
                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBox Text="{Binding EditName}" IsVisible="{Binding IsEditing}" Margin="0,4,0,0"
                                 KeyDown="NameEditor_KeyDown" LostFocus="NameEditor_LostFocus"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
