<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:TypeDCore.ViewModel.Panels"
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800"
             xmlns:local="clr-namespace:TypeDCore.View.Panels"
             x:Class="TypeDCore.View.Panels.ComponentBrowserPanel"
             x:DataType="vm:ComponentBrowserViewModel"
             MinWidth="100">
    <TreeView Name="TreeView" ItemsSource="{Binding Nodes}" DoubleTapped="TreeViewItem_MouseDoubleClickEvent">
        <TreeView.ItemTemplate>
            <TreeDataTemplate ItemsSource="{Binding Nodes}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0" Source="{Binding IconPath}" Width="8" Height="8"/>
                    <TextBlock Grid.Column="2" Text="{Binding Name}"/>
                </Grid>
            </TreeDataTemplate>
        </TreeView.ItemTemplate>
        
        <TreeView.ContextMenu>
            <ContextMenu Opened="ContextMenu_Opened"/>
        </TreeView.ContextMenu>
    </TreeView>
</UserControl>
