<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:TypeDCore.ViewModel.Panels"
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800"
             xmlns:local="clr-namespace:TypeDCore.View.Panels"
             x:Class="TypeDCore.View.Panels.ComponentExplorerPanel"
             x:DataType="vm:ComponentExplorerViewModel">
    <DockPanel>
    <TextBox DockPanel.Dock="Top" Text="{Binding FilterText}" Watermark="Filter nodes..." Margin="2"/>
    <TreeView Name="ComponentsTree" ItemsSource="{Binding VisibleNodes}"
              SelectedItem="{Binding SelectedNode}"
              SelectionChanged="ComponentsTree_SelectionChanged"
              GotFocus="ComponentsTree_GotFocus"
              KeyDown="ComponentsTree_KeyDown">
        <TreeView.Styles>
            <Style Selector="TreeViewItem">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            </Style>
        </TreeView.Styles>
        <TreeView.ItemTemplate>
            <TreeDataTemplate ItemsSource="{Binding VisibleNodes}">
                <Grid>
                    <TextBlock Text="{Binding Title}" IsVisible="{Binding !IsEditing}"/>
                    <TextBox Text="{Binding EditName}" IsVisible="{Binding IsEditing}"
                             KeyDown="NodeName_KeyDown"/>
                </Grid>
            </TreeDataTemplate>
        </TreeView.ItemTemplate>
        
        <TreeView.ContextMenu>
            <ContextMenu Opened="ContextMenu_Opened"/>
        </TreeView.ContextMenu>
    </TreeView>
    </DockPanel>
</UserControl>
