<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:TypeDCore.ViewModel.Panels"
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800"
             xmlns:local="clr-namespace:TypeDCore.View.Panels"
             x:Class="TypeDCore.View.Panels.ComponentExplorerPanel"
             x:DataType="vm:ComponentExplorerViewModel">
    <DockPanel>
    <TextBox DockPanel.Dock="Top" Text="{Binding FilterText}" Watermark="Filter nodes..." Margin="2"/>
    <TreeView Name="ComponentsTree" ItemsSource="{Binding VisibleNodes}"
              SelectedItem="{Binding SelectedNode}"
              SelectionChanged="ComponentsTree_SelectionChanged"
              GotFocus="ComponentsTree_GotFocus"
              KeyDown="ComponentsTree_KeyDown">
        <TreeView.Styles>
            <Style Selector="TreeViewItem">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            </Style>
            <Style Selector="TextBlock.removed">
                <Setter Property="TextDecorations" Value="Strikethrough"/>
                <Setter Property="Opacity" Value="0.5"/>
            </Style>
            <Style Selector="Border.noderow">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="BorderBrush" Value="#007ACC"/>
            </Style>
            <Style Selector="Border.noderow.dropbefore">
                <Setter Property="BorderThickness" Value="0,2,0,0"/>
            </Style>
            <Style Selector="Border.noderow.dropafter">
                <Setter Property="BorderThickness" Value="0,0,0,2"/>
            </Style>
            <Style Selector="Border.noderow.dropchild">
                <Setter Property="Background" Value="#66007ACC"/>
            </Style>
        </TreeView.Styles>
        <TreeView.ItemTemplate>
            <TreeDataTemplate ItemsSource="{Binding VisibleNodes}">
                <Border Classes="noderow" Classes.dropbefore="{Binding IsDropBefore}"
                        Classes.dropafter="{Binding IsDropAfter}" Classes.dropchild="{Binding IsDropChild}">
                    <Grid>
                        <TextBlock Text="{Binding Title}" IsVisible="{Binding !IsEditing}" Classes.removed="{Binding IsRemoved}"/>
                        <TextBox Text="{Binding EditName}" IsVisible="{Binding IsEditing}"
                                 KeyDown="NodeName_KeyDown"/>
                    </Grid>
                </Border>
            </TreeDataTemplate>
        </TreeView.ItemTemplate>
        
        <TreeView.ContextMenu>
            <ContextMenu Opening="ContextMenu_Opening"/>
        </TreeView.ContextMenu>
    </TreeView>
    </DockPanel>
</UserControl>
