<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:TypeDCore.ViewModel.Panels"
             xmlns:sys="using:System"
             xmlns:local="clr-namespace:TypeDCore.View.Panels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="TypeDCore.View.Panels.PropertiesPanel"
             x:DataType="vm:PropertiesViewModel">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <vm:TypeToDataTemplateConverter x:Key="TypeToDataTemplateConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <ListBox
         x:Name="PropertiesList"
         ItemsSource="{Binding PropertyNodes}"
         Grid.IsSharedSizeScope="True"
         Background="Transparent"
         Padding="0"
         BorderThickness="0">

        <ListBox.Styles>
            <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="Template">
                    <ControlTemplate>
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Stretch" />
                    </ControlTemplate>
                </Setter>
            </Style>

            <Style Selector="TextBox.PropertyInput">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
            </Style>
        </ListBox.Styles>

        <ListBox.ItemTemplate>
            <DataTemplate>
                <Grid Height="28" ToolTip.Tip="{Binding Description}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="0,0,1,1"
                            Padding="8,0">
                        <TextBlock Text="{Binding Name}"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    </Border>

                    <GridSplitter Grid.Column="1"
                                  Background="Transparent"
                                  Width="6"
                                  Margin="-3,0"
                                  ResizeDirection="Columns" />

                    <Border Grid.Column="2"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="0,0,0,1">
                        <ContentControl Content="{Binding .}"
                                        ContentTemplate="{Binding Converter={StaticResource TypeToDataTemplateConverter}}" />
                    </Border>
                </Grid>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>
</UserControl>
