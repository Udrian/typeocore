<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="640"
        xmlns:local="clr-namespace:TypeDCore.View.Dialogs.Project"
        x:Class="TypeDCore.View.Dialogs.Project.AddCustomPropertyDialog"
        Width="450" Height="640" MinWidth="300" MinHeight="220"
        Title="Add Property">
    <Grid Margin="25" RowDefinitions="Auto,Auto,*,Auto">
        <TextBlock x:Name="dialogHeading" FontSize="32" Text="Add Property"/>
        <Separator Grid.Row="1" Margin="0,0,0,25"/>
        <ScrollViewer x:Name="propertyFields" Grid.Row="2" Margin="0,0,0,10" VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical">
                <Label FontSize="16" Content="_Name:" Target="{Binding ElementName=txtName}"/>
                <TextBox x:Name="txtName" Margin="5,0,0,0" Text="{Binding PropertyName}"/>

                <Label FontSize="16" Content="_Value Type:" Target="{Binding ElementName=cmbType}"/>
                <ComboBox x:Name="cmbType" Margin="5,0,0,0" HorizontalAlignment="Stretch" ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}"/>

                <Label FontSize="16" Content="_Default Value:"/>
                <ContentControl x:Name="ctlDefaultValue" Margin="5,0,0,0" MinHeight="32"
                                HorizontalContentAlignment="Stretch"
                                Content="{Binding DefaultValueNode}"
                                ContentTemplate="{Binding DefaultValueTemplate}"/>

                <Label FontSize="16" Content="De_scription:" Target="{Binding ElementName=txtDescription}"/>
                <TextBox x:Name="txtDescription" Margin="5,0,0,0" Text="{Binding Description}"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" MaxHeight="120"/>

                <Label FontSize="16" Content="_Group:" Target="{Binding ElementName=txtGroup}"/>
                <AutoCompleteBox x:Name="txtGroup" Margin="5,0,0,0"
                                 ItemsSource="{Binding Groups}" Text="{Binding Group, Mode=TwoWay}"
                                 FilterMode="StartsWith" MinimumPrefixLength="0" IsTextCompletionEnabled="True"/>

                <Label FontSize="16" Content="A_ccess:" Target="{Binding ElementName=cmbAccess}"/>
                <ComboBox x:Name="cmbAccess" Margin="5,0,0,0" HorizontalAlignment="Stretch" ItemsSource="{Binding AccessOptions}" SelectedItem="{Binding SelectedAccess}"/>

                <TextBlock x:Name="validationError" Margin="5,10,0,0" Foreground="OrangeRed" TextWrapping="Wrap" Text="{Binding Error}" IsVisible="{Binding HasError}"/>
            </StackPanel>
        </ScrollViewer>
        <Grid x:Name="buttonPanel" Grid.Row="3" ColumnDefinitions="*,10,*">
            <Button x:Name="cancelButton" Grid.Column="0" Content="_Cancel" Height="50" FontSize="14"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="CancelButton_Click"/>
            <Button x:Name="submitButton" Grid.Column="2" Content="_Add" Height="50" FontSize="14"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="AddButton_Click"/>
        </Grid>
    </Grid>
</Window>
